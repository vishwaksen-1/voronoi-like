***********************************************************************************************************
***********************************************************************************************************
	VORONOI PATTERN 2-FORCED CHOICE (2FC) TASK
***********************************************************************************************************
***********************************************************************************************************

Script Author: Vishwaksen Reddy D
Created: 02/02/2026
Last Updated: 13/02/2026

Script Purpose:
This script implements a 2-Forced Choice task to measure implicit preferences for Voronoi patterns.
Participants view pairs of images (Original vs Warped Voronoi patterns) and select their preferred image.

The experiment includes TWO conditions:
1. RELATED PAIRS: Original_pair[i] vs Warped_pair[i] (same structural base, warped transformation)
2. RANDOM PAIRS: Original_pair[i] vs Warped_pair[j] where i ≠ j (structurally independent)

Key Features:
- Configurable trial count via M_multiplier parameter (M × 20 trials per block)
- Counterbalanced left/right position
- Separate logging for related vs random trial types
- Self-paced responses (no timeout by default)
- Works with mouse clicks or keyboard (E/I keys)

Duration: ~10-15 minutes (depending on M parameter)

***********************************************************************************************************
***********************************************************************************************************
	EDITABLE PARAMETERS
***********************************************************************************************************
***********************************************************************************************************

<parameters>
/ M_multiplier = 2
// Determines number of trials per block: M × 20
// Set to 1 for 20 trials, 2 for 40 trials, 4 for 80 trials per block

/ stimSize = 35%
// Image size as percentage of screen height

/ fixationDuration = 500
// Duration of fixation cross in milliseconds

/ leftKey = "e"
// Keyboard key for selecting left image

/ rightKey = "i"
// Keyboard key for selecting right image

/ questionPrompt = "Which pattern do you prefer?"
// Question displayed during trials (can be edited later)

/ showFixation = true
// Set to false to remove fixation cross

/ includeRestScreen = true
// Set to false to remove rest screen between blocks
</parameters>

***********************************************************************************************************
***********************************************************************************************************
	AUTOMATICALLY UPDATED VALUES
***********************************************************************************************************
***********************************************************************************************************

<values>
// Trial counting
/ trialCount_practice = 0
/ trialCount_related = 0
/ trialCount_random = 0

// Current trial information
/ currentOriginalIndex = 0
/ currentWarpedIndex = 0
/ currentTrialType = ""
/ originalPosition = ""
/ positionCode = 0
// 1 = Left, 2 = Right (used for branching logic)

// Response coding
/ responseCode = 0
// 1 = selected original, -1 = selected warped

// Summary statistics for related block
/ relatedBlock_originalCount = 0
/ relatedBlock_warpedCount = 0
/ relatedBlock_totalLatency = 0

// Summary statistics for random block
/ randomBlock_originalCount = 0
/ randomBlock_warpedCount = 0
/ randomBlock_totalLatency = 0

// Random pairing storage (for random block)
/ randomPair_1 = 0
/ randomPair_2 = 0
/ randomPair_3 = 0
/ randomPair_4 = 0
/ randomPair_5 = 0
/ randomPair_6 = 0
/ randomPair_7 = 0
/ randomPair_8 = 0
/ randomPair_9 = 0
/ randomPair_10 = 0
/ randomPair_11 = 0
/ randomPair_12 = 0
/ randomPair_13 = 0
/ randomPair_14 = 0
/ randomPair_15 = 0
/ randomPair_16 = 0
/ randomPair_17 = 0
/ randomPair_18 = 0
/ randomPair_19 = 0
/ randomPair_20 = 0
</values>

***********************************************************************************************************
***********************************************************************************************************
	EXPRESSIONS
***********************************************************************************************************
***********************************************************************************************************

<expressions>
// Calculate total number of trials per block
/ totalTrialsPerBlock = parameters.M_multiplier * 20

// Calculate proportion of original selections in related block
/ relatedBlock_proportionOriginal = values.relatedBlock_originalCount / values.trialCount_related

// Calculate proportion of original selections in random block
/ randomBlock_proportionOriginal = values.randomBlock_originalCount / values.trialCount_random

// Calculate mean latency in related block
/ meanLatency_related = values.relatedBlock_totalLatency / values.trialCount_related

// Calculate mean latency in random block
/ meanLatency_random = values.randomBlock_totalLatency / values.trialCount_random

// Get warped pair number for current random trial
/ currentRandomWarpedPair = if (values.currentOriginalIndex == 1) {
		values.randomPair_1;
	} else if (values.currentOriginalIndex == 2) {
		values.randomPair_2;
	} else if (values.currentOriginalIndex == 3) {
		values.randomPair_3;
	} else if (values.currentOriginalIndex == 4) {
		values.randomPair_4;
	} else if (values.currentOriginalIndex == 5) {
		values.randomPair_5;
	} else if (values.currentOriginalIndex == 6) {
		values.randomPair_6;
	} else if (values.currentOriginalIndex == 7) {
		values.randomPair_7;
	} else if (values.currentOriginalIndex == 8) {
		values.randomPair_8;
	} else if (values.currentOriginalIndex == 9) {
		values.randomPair_9;
	} else if (values.currentOriginalIndex == 10) {
		values.randomPair_10;
	} else if (values.currentOriginalIndex == 11) {
		values.randomPair_11;
	} else if (values.currentOriginalIndex == 12) {
		values.randomPair_12;
	} else if (values.currentOriginalIndex == 13) {
		values.randomPair_13;
	} else if (values.currentOriginalIndex == 14) {
		values.randomPair_14;
	} else if (values.currentOriginalIndex == 15) {
		values.randomPair_15;
	} else if (values.currentOriginalIndex == 16) {
		values.randomPair_16;
	} else if (values.currentOriginalIndex == 17) {
		values.randomPair_17;
	} else if (values.currentOriginalIndex == 18) {
		values.randomPair_18;
	} else if (values.currentOriginalIndex == 19) {
		values.randomPair_19;
	} else if (values.currentOriginalIndex == 20) {
		values.randomPair_20;
	}
</expressions>

***********************************************************************************************************
