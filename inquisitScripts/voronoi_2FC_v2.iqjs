***********************************************************************************************************
	PICTURE STIMULI
***********************************************************************************************************

<picture leftImage>
/ items = all_voronoi_images
/ select = values.currentLeftIndex
/ position = (25%, 50%)
/ size = (parameters.stimSize, parameters.stimSize)
/ valign = center
/ halign = center
</picture>

<picture rightImage>
/ items = all_voronoi_images
/ select = values.currentRightIndex
/ position = (75%, 50%)
/ size = (parameters.stimSize, parameters.stimSize)
/ valign = center
/ halign = center
</picture>

***********************************************************************************************************
	TEXT STIMULI
***********************************************************************************************************

<text fixationCross>
/ items = ("+")
/ fontstyle = ("Arial", 5%)
/ position = (50%, 50%)
/ txcolor = white
</text>

<text trialInstructions>
/ items = ("<%parameters.questionPrompt%>")
/ fontstyle = ("Arial", 2.5%)
/ position = (50%, 12%)
/ txcolor = white
</text>

<text responseReminder>
/ items = ("Use the mouse to click on your preferred image")
/ fontstyle = ("Arial", 1.8%)
/ position = (50%, 88%)
/ txcolor = (180, 180, 180)
</text>

<text finishMessage>
/ items = ("Block Complete! Take a brief rest.")
/ fontstyle = ("Arial", 3%)
/ position = (50%, 50%)
/ txcolor = white
</text>

<text endExptMessage>
/ items = ("Thank you for completing this task!

Your responses have been recorded.")
/ fontstyle = ("Arial", 3%)
/ position = (50%, 50%)
/ txcolor = white
</text>

***********************************************************************************************************
	TRIALS
***********************************************************************************************************

<trial fixation>
/ stimulusframes = [1 = fixationCross]
/ timeout = parameters.fixationDuration
/ recorddata = false
/ branch = { return trial.show_images; }
</trial>

<trial show_images>
/ stimulusframes = [1 = leftImage, rightImage, trialInstructions, responseReminder]
/ inputdevice = mouse
/ validresponse = (leftImage, rightImage)
/ ontrialend = {
	values.trialCount_total += 1;

	// Determine response (compared as a string)
	if (trial.show_images.response == "leftImage") {
		if (values.selectPosition == 1) {
			values.responseCode = 1;
			values.originalPosition = "left";
		} else {
			values.responseCode = -1;
			values.originalPosition = "right";
		}
	} else {
		if (values.selectPosition == 1) {
			values.responseCode = -1;
			values.originalPosition = "left";
		} else {
			values.responseCode = 1;
			values.originalPosition = "right";
		}
	}

	// Update block-specific counts
	if (values.currentBlockType == "block1A") {
		values.trialCount_block1A += 1;
		values.block1A_totalLatency += trial.show_images.latency;
		if (values.responseCode == 1) {
			values.block1A_originalCount += 1;
		} else {
			values.block1A_warpedCount += 1;
		}
	} else if (values.currentBlockType == "block1B") {
		values.trialCount_block1B += 1;
		values.block1B_totalLatency += trial.show_images.latency;
		
		// Fixed Logic: Ensure the chosen side maps to the correct original/warped border metadata
		if (trial.show_images.response == "leftImage") {
			if (values.selectPosition == 1) {
				values.borderResponseCode = values.currentOriginalBorder;
			} else {
				values.borderResponseCode = values.currentWarpedBorder;
			}
		} else {
			if (values.selectPosition == 1) {
				values.borderResponseCode = values.currentWarpedBorder;
			} else {
				values.borderResponseCode = values.currentOriginalBorder;
			}
		}
		
		if (values.borderResponseCode == "clean") {
			values.block1B_cleanCount += 1;
		} else if (values.borderResponseCode == "blue") {
			values.block1B_blueCount += 1;
		} else {
			values.block1B_orangeCount += 1;
		}
	} else if (values.currentBlockType == "block2A") {
		values.trialCount_block2A += 1;
		values.block2A_totalLatency += trial.show_images.latency;
		if (values.responseCode == 1) {
			values.block2A_originalCount += 1;
		} else {
			values.block2A_warpedCount += 1;
		}
	} else if (values.currentBlockType == "block2B") {
		values.trialCount_block2B += 1;
		values.block2B_totalLatency += trial.show_images.latency;
		if (values.responseCode == 1) {
			values.block2B_originalCount += 1;
		} else {
			values.block2B_warpedCount += 1;
		}
	} else if (values.currentBlockType == "practice") {
		values.trialCount_practice += 1;
	}
}
</trial>

***********************************************************************************************************
	SELECTOR TRIALS
***********************************************************************************************************

<trial selector_practice>
/ ontrialbegin = {
	values.currentBlockType = "practice";
	values.currentTrialType = "pattern_same_border";

	values.selectPairID = parseInt(list.pairIDs.nextValue, 10);
	values.selectBorderType = parseInt(list.borderTypes.nextValue, 10);

	// Metadata
	values.currentOriginalIndex = values.selectPairID;
	values.currentWarpedIndex = values.selectPairID;
	
	// Set border names
	if (values.selectBorderType == 0) {
		values.currentOriginalBorder = "clean";
		values.currentWarpedBorder = "clean";
	} else if (values.selectBorderType == 1) {
		values.currentOriginalBorder = "blue";
		values.currentWarpedBorder = "blue";
	} else {
		values.currentOriginalBorder = "orange";
		values.currentWarpedBorder = "orange";
	}

	values.selectPosition = parseInt(list.positions.nextValue, 10);

	var idxOrig = (values.selectBorderType * 20) + values.selectPairID;
	var idxWarp = 60 + (values.selectBorderType * 20) + values.selectPairID;

	if (values.selectPosition == 1) {
		values.currentLeftIndex = parseInt(idxOrig, 10);
		values.currentRightIndex = parseInt(idxWarp, 10);
	} else {
		values.currentLeftIndex = parseInt(idxWarp, 10);
		values.currentRightIndex = parseInt(idxOrig, 10);
	}
}
/ trialduration = 0
/ recorddata = false
/ branch = { return trial.fixation; }
</trial>

<trial selector_1A>
/ ontrialbegin = {
	values.currentBlockType = "block1A";
	values.currentTrialType = "pattern_same_border";

	values.selectPairID = parseInt(list.pairIDs.nextValue, 10);
	values.selectBorderType = parseInt(list.borderTypes.nextValue, 10);

	// Metadata
	values.currentOriginalIndex = values.selectPairID;
	values.currentWarpedIndex = values.selectPairID;
	
	// Set border names
	if (values.selectBorderType == 0) {
		values.currentOriginalBorder = "clean";
		values.currentWarpedBorder = "clean";
	} else if (values.selectBorderType == 1) {
		values.currentOriginalBorder = "blue";
		values.currentWarpedBorder = "blue";
	} else {
		values.currentOriginalBorder = "orange";
		values.currentWarpedBorder = "orange";
	}

	values.selectPosition = parseInt(list.positions.nextValue, 10);

	var idxOrig = (values.selectBorderType * 20) + values.selectPairID;
	var idxWarp = 60 + (values.selectBorderType * 20) + values.selectPairID;

	if (values.selectPosition == 1) {
		values.currentLeftIndex = parseInt(idxOrig, 10);
		values.currentRightIndex = parseInt(idxWarp, 10);
	} else {
		values.currentLeftIndex = parseInt(idxWarp, 10);
		values.currentRightIndex = parseInt(idxOrig, 10);
	}
}
/ trialduration = 0
/ recorddata = false
/ branch = { return trial.fixation; }
</trial>

<trial selector_1B>
/ ontrialbegin = {
	values.currentBlockType = "block1B";

	values.selectPairID = parseInt(list.pairIDs.nextValue, 10);
	values.selectBorderCombo = parseInt(list.borderCombos_1B.nextValue, 10);
	values.selectPatternType = parseInt(list.patternTypes.nextValue, 10);

	// Identify Borders for the combo
	var b1 = 0;
	var b2 = 0;
	if (values.selectBorderCombo == 1) {
		b1 = 1; b2 = 2; // blue vs orange
	} else if (values.selectBorderCombo == 2) {
		b1 = 1; b2 = 0; // blue vs clean
	} else {
		b1 = 2; b2 = 0; // orange vs clean
	}

	// Metadata
	values.currentOriginalIndex = values.selectPairID;
	values.currentWarpedIndex = values.selectPairID;

	var baseOffset = 0;
	if (values.selectPatternType == 0) {
		values.currentTrialType = "border_same_original";
		baseOffset = 0;
	} else {
		values.currentTrialType = "border_same_warped";
		baseOffset = 60;
	}

	var idxLeft = baseOffset + (b1 * 20) + values.selectPairID;
	var idxRight = baseOffset + (b2 * 20) + values.selectPairID;

	// Set border names
	if (b1 == 0) {
		values.currentOriginalBorder = "clean";
	} else if (b1 == 1) {
		values.currentOriginalBorder = "blue";
	} else {
		values.currentOriginalBorder = "orange";
	}

	if (b2 == 0) {
		values.currentWarpedBorder = "clean";
	} else if (b2 == 1) {
		values.currentWarpedBorder = "blue";
	} else {
		values.currentWarpedBorder = "orange";
	}

	values.selectPosition = parseInt(list.positions.nextValue, 10);

	if (values.selectPosition == 1) {
		values.currentLeftIndex = parseInt(idxLeft, 10);
		values.currentRightIndex = parseInt(idxRight, 10);
	} else {
		values.currentLeftIndex = parseInt(idxRight, 10);
		values.currentRightIndex = parseInt(idxLeft, 10);
	}
}
/ trialduration = 0
/ recorddata = false
/ branch = { return trial.fixation; }
</trial>

<trial selector_2A>
/ ontrialbegin = {
	values.currentBlockType = "block2A";
	values.currentTrialType = "pattern_cross_border";

	values.selectBorderCombo = parseInt(list.borderCombos_2A.nextValue, 10);
	values.selectPairID = parseInt(list.pairIDs.nextValue, 10);

	// Determine Borders for Original (bOrig) and Warped (bWarp)
	var bOrig = 0;
	var bWarp = 0;
	if (values.selectBorderCombo == 1) {
		bOrig = 1; bWarp = 2; // blue vs orange
	} else if (values.selectBorderCombo == 2) {
		bOrig = 1; bWarp = 0; // blue vs clean
	} else if (values.selectBorderCombo == 3) {
		bOrig = 2; bWarp = 1; // orange vs blue
	} else if (values.selectBorderCombo == 4) {
		bOrig = 2; bWarp = 0; // orange vs clean
	} else if (values.selectBorderCombo == 5) {
		bOrig = 0; bWarp = 1; // clean vs blue
	} else {
		bOrig = 0; bWarp = 2; // clean vs orange
	}

	// Metadata
	values.currentOriginalIndex = values.selectPairID;
	values.currentWarpedIndex = values.selectPairID;

	var idxOrig = (bOrig * 20) + values.selectPairID;
	var idxWarp = 60 + (bWarp * 20) + values.selectPairID;

	// Set border names
	if (bOrig == 0) {
		values.currentOriginalBorder = "clean";
	} else if (bOrig == 1) {
		values.currentOriginalBorder = "blue";
	} else {
		values.currentOriginalBorder = "orange";
	}

	if (bWarp == 0) {
		values.currentWarpedBorder = "clean";
	} else if (bWarp == 1) {
		values.currentWarpedBorder = "blue";
	} else {
		values.currentWarpedBorder = "orange";
	}

	values.selectPosition = parseInt(list.positions.nextValue, 10);

	if (values.selectPosition == 1) {
		values.currentLeftIndex = parseInt(idxOrig, 10);
		values.currentRightIndex = parseInt(idxWarp, 10);
	} else {
		values.currentLeftIndex = parseInt(idxWarp, 10);
		values.currentRightIndex = parseInt(idxOrig, 10);
	}
}
/ trialduration = 0
/ recorddata = false
/ branch = { return trial.fixation; }
</trial>

<trial selector_2B>
/ ontrialbegin = {
	values.currentBlockType = "block2B";
	values.currentTrialType = "random_pairs_varied_borders";

	// Using standard Javascript Math object functions to replace 'rand()' compatibility
	var i = Math.floor(Math.random() * 20) + 1;
	var j = Math.floor(Math.random() * 20) + 1;
	while (j == i) {
		j = Math.floor(Math.random() * 20) + 1;
	}

	values.currentOriginalIndex = i;
	values.currentWarpedIndex = j;

	// Random borders
	var bOrig = Math.floor(Math.random() * 3);
	var bWarp = Math.floor(Math.random() * 3);

	var idxOrig = (bOrig * 20) + i;
	var idxWarp = 60 + (bWarp * 20) + j;

	// Set border names
	if (bOrig == 0) {
		values.currentOriginalBorder = "clean";
	} else if (bOrig == 1) {
		values.currentOriginalBorder = "blue";
	} else {
		values.currentOriginalBorder = "orange";
	}

	if (bWarp == 0) {
		values.currentWarpedBorder = "clean";
	} else if (bWarp == 1) {
		values.currentWarpedBorder = "blue";
	} else {
		values.currentWarpedBorder = "orange";
	}

	values.selectPosition = parseInt(list.positions.nextValue, 10);

	if (values.selectPosition == 1) {
		values.currentLeftIndex = parseInt(idxOrig, 10);
		values.currentRightIndex = parseInt(idxWarp, 10);
	} else {
		values.currentLeftIndex = parseInt(idxWarp, 10);
		values.currentRightIndex = parseInt(idxOrig, 10);
	}
}
/ trialduration = 0
/ recorddata = false
/ branch = { return trial.fixation; }
</trial>

<trial finish_block>
/ stimulusframes = [1 = finishMessage]
/ timeout = 2000
/ recorddata = false
</trial>

<trial finish_expt>
/ stimulusframes = [1 = endExptMessage]
/ timeout = 3000
/ recorddata = false
</trial>

***********************************************************************************************************
	BLOCKS
***********************************************************************************************************

<block practice>
/ preinstructions = (welcome, practiceInstructions)
/ trials = [1-10 = selector_practice; 11 = finish_block]
</block>

<block block1A>
/ preinstructions = (block1A_instruct)
// 60 trials: 20 pairs * 3 borders
/ trials = [1-60 = selector_1A; 61 = finish_block]
</block>

<block block1B>
/ preinstructions = (block1B_instruct)
// 120 trials: 20 pairs * 2 types * 3 border combos
/ trials = [1-120 = selector_1B; 121 = finish_block]
</block>

<block block2A>
/ preinstructions = (block2A_instruct)
// 120 trials: 20 pairs * 6 border combos
/ trials = [1-120 = selector_2A; 121 = finish_block]
</block>

<block block2B>
/ preinstructions = (block2B_instruct)
// 60 trials random
/ trials = [1-60 = selector_2B; 61 = finish_block]
</block>

<block end>
/ trials = [1 = finish_expt]
</block>

***********************************************************************************************************
	EXPERIMENTS (LATIN SQUARE GROUPS)
***********************************************************************************************************

// Group 1: 1A -> 1B -> 2A -> 2B
<expt group1>
/ subjects = (1 of 6)
/ blocks = [1=practice; 2=block1A; 3=block1B; 4=block2A; 5=block2B; 6=end]
</expt>

// Group 2: 1A -> 2A -> 1B -> 2B
<expt group2>
/ subjects = (2 of 6)
/ blocks = [1=practice; 2=block1A; 3=block2A; 4=block1B; 5=block2B; 6=end]
</expt>

// Group 3: 1B -> 1A -> 2A -> 2B
<expt group3>
/ subjects = (3 of 6)
/ blocks = [1=practice; 2=block1B; 3=block1A; 4=block2A; 5=block2B; 6=end]
</expt>

// Group 4: 1B -> 2A -> 1A -> 2B
<expt group4>
/ subjects = (4 of 6)
/ blocks = [1=practice; 2=block1B; 3=block2A; 4=block1A; 5=block2B; 6=end]
</expt>

// Group 5: 2A -> 1A -> 1B -> 2B
<expt group5>
/ subjects = (5 of 6)
/ blocks = [1=practice; 2=block2A; 3=block1A; 4=block1B; 5=block2B; 6=end]
</expt>

// Group 6: 2A -> 1B -> 1A -> 2B
<expt group6>
/ subjects = (6 of 6)
/ blocks = [1=practice; 2=block2A; 3=block1B; 4=block1A; 5=block2B; 6=end]
</expt>

***********************************************************************************************************
	DATA OUTPUT
***********************************************************************************************************

<data>
/ columns = (
	build, computer.platform, date, time, subject, group, session,
	blockcode, trialnum,
	values.currentBlockType, values.currentTrialType,
	values.trialCount_total,
	values.currentOriginalIndex, values.currentWarpedIndex,
	values.currentOriginalBorder, values.currentWarpedBorder,
	stimulusitem, stimulusitem,
	response, values.responseCode, values.borderResponseCode,
	values.originalPosition, latency
)
</data>

***********************************************************************************************************
	INSTRUCTION PAGES
***********************************************************************************************************

<instruct>
/ fontstyle = ("Arial", 2.5%)
/ txcolor = white
/ windowsize = (90%, 90%)
</instruct>

<page welcome>
^^Welcome to this study!
^^You will view pairs of visual patterns.
^^Your task is to select the pattern that you prefer in each pair.
^^
Press SPACE to continue.
</page>

<page practiceInstructions>
^^PRACTICE
^^
Use the Mouse to click on the image you prefer.
^^
Respond based on your first impression.
^^
Press SPACE to begin practice.
</page>

<page block1A_instruct>
^^BLOCK 1
^^
You will see pairs of patterns.
Select the one you prefer.
^^
Press SPACE to start.
</page>

<page block1B_instruct>
^^BLOCK 2
^^
You will see pairs of patterns.
Pay attention to the overall look.
Select the one you prefer.
^^
Press SPACE to start.
</page>

<page block2A_instruct>
^^BLOCK 3
^^
Continue selecting your preferred pattern.
Some may have different colored borders.
Choose based on which pattern you like best.
^^
Press SPACE to start.
</page>

<page block2B_instruct>
^^BLOCK 4
^^
Final set.
Select the pattern you prefer.
^^
Press SPACE to start.
</page>

***********************************************************************************************************
	DEFAULTS
***********************************************************************************************************

<defaults>
/ canvasaspectratio = (4, 3)
/ fontstyle = ("Arial", 2%)
/ screencolor = White
/ txcolor = Black
</defaults>


